<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @title %> - <%= @site_title %></title>
  <link rel="stylesheet" href="<%= @url_prefix %>/css/style.css">
  <style>
    .site-header {
      background: linear-gradient(to right, rgba(139, 69, 19, 0.05), rgba(90, 74, 58, 0.05));
      border-bottom-color: rgba(139, 69, 19, 0.1);
    }

    .site-header-nav a {
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      transition: background-color 0.15s;
    }

    .site-header-nav a:hover {
      background: rgba(139, 69, 19, 0.1);
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a href="<%= @url_prefix %>/index.html" class="site-header-title"><%= @site_title %></a>
    <nav class="site-header-nav">
      <a href="/">Home</a>
      <a href="/about.html">About</a>
    </nav>
  </header>
  <div class="site-container">
    <%= @content %>
  </div>
</body>
</html>
